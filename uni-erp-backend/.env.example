PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/uni-erp
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5173
# Ask students for their date of birth as well as roll number on the public result page
RESULT_REQUIRE_DOB=false
# Production: set NODE_ENV=production, a long random JWT_SECRET, and TRUST_PROXY=1 when behind a proxy or host
NODE_ENV=development
TRUST_PROXY=
